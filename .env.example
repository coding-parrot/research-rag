# Copy to .env (gitignored). Secrets live here and nowhere else.
# Never put keys in config files, notebooks, or code.

# Required only when generate.provider = anthropic (the default).
# Leave unset to use an `ant auth login` profile instead.
ANTHROPIC_API_KEY=

# Required only when retrieve.reranker = cohere. The default reranker is a local
# cross-encoder and needs no key.
COHERE_API_KEY=
